<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<!-- CSS principal -->
<link rel="stylesheet" href="/css/pagina_busqueda.css">

<!-- Estilos de cartas y grid -->
<link rel="stylesheet" href="/css/carta.css">
<link rel="stylesheet" href="/css/grid_motos.css">

<!-- Fuente -->
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;700&display=swap" rel="stylesheet">

<title>Museo del Ciclomotor</title>
</head>

<div class="contenedor-base">
  <!-- todo tu contenido -->
</div>
<body>

<!-- 
  ❌ BOTÓN MOVIDO
  (Ya no está acá)
-->

<!-- Navbar -->
<div class="navbar" id="navbar">
    <a href="/pagina_busqueda" class="pantalla-click">
    <img src="/img/logotipo Museo Ciclomotor celeste.png" alt="Museo del Ciclomotor">
    </a>
</div>

<!-- Contenido -->
<div class="container">
    <h1>¡Bienvenido!</h1>
    <h2>¡Buscá en nuestro tótem tu modelo preferido!</h2>
    
    <!-- Buscador -->
    <div class="search-box">
        <form class="barra-busqueda-header" action="/product/search" method="GET">
            <input class="input-header" type="text" placeholder="¡Buscá tu modelo, Segun el codigo!" name="search">

            <!-- <select name="campo" class="select-header">
                <option value="modelo">Modelo</option>
                <option value="origen">Origen</option>
                <option value="marca">Marca</option>
                <option value="rodado">Rodado</option>
            </select> -->

            <div class="contenedor-medio">
                <select id="111" name="valorDispo" class="codigo-select" aria-label="Seleccionar código">
                <option value="null">Disponibles</option>
                <% for(let i = 0; i < cod.length; i++) { %>
                <option value="<%= cod[i]%>"><%= cod[i] %></option>
                <% } %>
            </select>
            
            <!-- 
              ✅ CAMBIO: BOTÓN DE "CARGA DE DATOS" MOVIDO ACÁ 
              Está adentro del form, junto a los otros campos de búsqueda.
            -->
            <a href="#" id="btn-carga-datos" class="btn-carga-datos">Carga de Datos</a>
            </div>
            

            <div class="button-header">
                <button class="button-search" type="submit">
                    <i class="fa-solid fa-magnifying-glass"></i> ¡Iniciá la Busqueda!
                </button>
            </div>
        </form>
      
    </div>
    
    
    
    <h3>¡Acá tenés modelos que podrían gustarte!</h3>
   

    <!-- Lista de modelos -->
    <div class="models">
        <% if(typeof product !== 'undefined' && product.length > 0) { %>
            <%- include('../partials/grid_motos.ejs') %>
        <% } else { %>
            <h1>Aún no hay modelos cargados.</h1>
            
        <% } %>
    </div>
</div>

<!-- 
  POPUP DE CONTRASEÑA (Sin cambios)
-->
<div class="popup-overlay" id="popup-overlay">
  <div class="popup-box">
      <h4>Acceso de Administrador</h4>
      <p>Ingresá la contraseña para acceder a la carga de datos.</p>
      
      <div class="popup-form">
          <label for="popup-password">Contraseña:</label>
          <input type="password" id="popup-password" class="popup-input">
          <p id="popup-error" class="popup-error-msg"></p>
      </div>
      
      <div class="popup-buttons">
          <button type="button" id="btn-cerrar-popup" class="popup-btn-cerrar">Cerrar</button>
          <button type="button" id="btn-validar-popup" class="popup-btn-validar">Validar</button>
      </div>
  </div>
</div>

<!-- 
  SCRIPT (Sin cambios)
-->
<script>
  document.addEventListener('DOMContentLoaded', () => {
      // Elementos
      const btnCarga = document.getElementById('btn-carga-datos');
      const popupOverlay = document.getElementById('popup-overlay');
      const btnCerrar = document.getElementById('btn-cerrar-popup');
      const btnValidar = document.getElementById('btn-validar-popup');
      const inputPass = document.getElementById('popup-password');
      const errorMsg = document.getElementById('popup-error');

      // Abrir popup
      btnCarga.addEventListener('click', (e) => {
          e.preventDefault(); // Evita que el <a> navegue
          popupOverlay.style.display = 'block';
          inputPass.focus();
      });

      // Cerrar popup (con botón o clickeando afuera)
      function cerrarPopup() {
          popupOverlay.style.display = 'none';
          inputPass.value = ''; // Limpia la contraseña
          errorMsg.textContent = ''; // Limpia el error
      }

      btnCerrar.addEventListener('click', cerrarPopup);
      popupOverlay.addEventListener('click', (e) => {
          // Si clickea en el fondo gris (overlay) y no en la caja (box)
          if (e.target === popupOverlay) {
              cerrarPopup();
          }
      });

      // Validar contraseña
      btnValidar.addEventListener('click', () => {
          const pass = inputPass.value;
          if (pass === 'ciclomotor2025') {
              // ¡Correcto! Redireccionamos al formulario
              // (Asumo que esta es la ruta de tu formulario de carga)
              window.location.href = '/formulario-carga'; 
          } else {
              // Error
              errorMsg.textContent = 'Contraseña incorrecta. Intentá de nuevo.';
              inputPass.focus();
          }
      });

      // También valida con "Enter"
      inputPass.addEventListener('keyup', (e) => {
          if (e.key === 'Enter') {
              btnValidar.click();
          }
      });
  });
</script>

</body>
</html>