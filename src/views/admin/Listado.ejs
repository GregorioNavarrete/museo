<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Motos</title>

    <!-- 1. Agregado Font Awesome para los íconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- 2. Agregado CSS para replicar el diseño de la imagen -->
    <style>
      :root {
    /* ------------------------------------------- */
    /* Paleta base del Museo (Blue/Red Theme)      */
    /* ------------------------------------------- */
    --COLOR-FONDO-NEGRO: #000000;
    --COLOR-FONDO-BLANCO-TRASP: #ffffffb7;
    --COLOR-FONDO-ROJO-GRADIENTE: #0081dbe0; /* Azul principal con opacidad */

    --COLOR-ROJO: #0081db; /* Azul Brillante (Accent Primario) */
    --COLOR-ROJO-CLARO: #c7eaff; /* Azul Muy Claro */
    --COLOR-ROJO-OSC: #005a96; /* Azul Oscuro (Deep Navy) */

    --COLOR-TEXTO-BLANCO: #ffffff;
    --COLOR-TEXTO-NEGRO: #000000;

    --COLOR-BORDE-BOTON: #ffffff;
    --COLOR-BOTON-FONDO: linear-gradient(to bottom, #ffffff, #0057aa);

    --COLOR-GRADIENTE-CARTA: linear-gradient(to bottom, #e4f4ff, var(--COLOR-ROJO-OSC));


    /* ------------------------------------------- */
    /* Variables Nuevas Mapeadas (Adaptación)      */
    /* ------------------------------------------- */
    
    /* Mapeado a tu Azul Principal */
    --color-principal: var(--COLOR-ROJO); 
    
    /* Mapeado al color de fondo más claro */
    --color-fondo: var(--COLOR-ROJO-CLARO); 
    
    /* Mapeado a tu Negro puro para texto oscuro */
    --color-texto: var(--COLOR-TEXTO-NEGRO);
    
    /* Un gris oscuro estándar para texto secundario */
    --color-texto-secundario: #555555; 
    
    /* Mapeado a tu Azul Oscuro (para títulos prominentes) */
    --color-titulo: var(--COLOR-ROJO-OSC); 
    
    /* Color utilitario: Verde para Stock (no existía, se mantiene el valor original) */
    --color-stock: #5CB85C; 
    
    /* Mapeado a tu Blanco */
    --color-blanco: var(--COLOR-TEXTO-BLANCO);
    
    /* Sombra clara adaptada para fondos oscuros */
    --sombra-card: 0 4px 12px rgba(255, 255, 255, 0.1); 
    
    /* Radio de borde estándar */
    --borde-radio: 12px;
}

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--color-fondo);
            color: var(--color-texto);
            margin: 0;
            padding: 0;
        }

        main {
            padding: 1.5rem;
            max-width: 1000px;
            margin: 2rem auto;
        }

        /* --- Estilos para la Cabecera (Buscador, Título, Añadir) --- */

        .SearchBox {
            background-color: var(--color-principal);
            padding: 1rem 1.5rem;
            border-radius: var(--borde-radio);
            box-shadow: var(--sombra-card);
            margin-bottom: 2rem;
        }

        .conte-titulo-form-carga {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1rem;
        }

        .titulo-icon-form-carga {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 1.75rem;
            font-weight: 600;
            color: var(--color-blanco);
        }

        .icon-form-carga i,
        .icon-carga-producto i {
            font-size: 1.5rem;
            color: var(--color-blanco);
        }

        .icon-carga-producto {
            background-color: rgba(255, 255, 255, 0.3);
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .icon-carga-producto:hover {
            background-color: rgba(255, 255, 255, 0.5);
        }

        /* Formulario de Búsqueda */
        .lista-libros-busq {
            display: flex;
            width: 100%;
            background-color: var(--color-blanco);
            border-radius: 8px;
            overflow: hidden;
        }

        .input-text-busq {
            border: none;
            padding: 0.75rem 1rem;
            font-size: 1rem;
            flex-grow: 1;
            outline: none;
        }

        .button-busq {
            border: none;
            background-color: #f8f8f8;
            padding: 0 1.25rem;
            cursor: pointer;
            color: var(--color-principal);
            font-size: 1rem;
            transition: background-color 0.3s ease;
        }

        .button-busq:hover {
            background-color: #eee;
        }

        /* --- Estilos para la Lista de Productos (Motos) --- */

        .IndexList {
            width: 100%;
        }

        .Productos {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        /* Estilo de cada Tarjeta de Producto */
        .Producto {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: var(--color-blanco);
            padding: 1rem 1.5rem;
            border-radius: var(--borde-radio);
            box-shadow: var(--sombra-card);
            border: 1px solid #eee;
            gap: 1rem;
        }

        /* Contenedor de Acciones (Izquierda) */
        .producto-acciones {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            flex-shrink: 0;
            width: 100px; /* Ancho fijo para alinear */
        }

        .accion-link {
            text-decoration: none;
            color: var(--color-principal);
            font-weight: 500;
            font-size: 0.9rem;
        }
        .accion-link:hover {
            text-decoration: underline;
        }

        .btn-borrar {
            background: none;
            border: none;
            padding: 0;
            margin-top: 0.5rem;
            cursor: pointer;
            color: var(--color-texto-secundario);
            font-size: 1.2rem;
            text-align: left;
        }
        .btn-borrar:hover {
            color: var(--color-titulo);
        }

        /* Contenedor de Info (Centro) */
        .producto-info {
            flex-grow: 1;
            text-align: center;
        }

        .info-titulo {
            font-size: 1.25rem;
            font-weight: 600;
            color: var(--color-titulo);
            text-decoration: none;
            display: block;
            margin-bottom: 0.25rem;
        }
        .info-titulo:hover {
            text-decoration: underline;
        }

        .info-subtitulo {
            font-size: 0.9rem;
            color: var(--color-texto-secundario);
            display: block;
            margin-bottom: 0.25rem;
        }

        .info-stock {
            font-size: 1rem;
            font-weight: 500;
            color: var(--color-stock);
            display: block;
        }

        /* Contenedor de Imagen (Derecha) */
        .producto-imagen {
            flex-shrink: 0;
        }

        .producto-imagen img {
            width: 100px;
            height: 100px; /* Ajustado para motos, no libros */
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid #eee;
        }

        /* Responsive */
        @media (max-width: 600px) {
            .Producto {
                flex-direction: column;
                align-items: stretch;
                padding: 1rem;
            }
            .producto-info {
                text-align: left;
                order: -1; /* Pone la info primero */
            }
            .producto-acciones {
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                width: 100%;
                margin-top: 1rem;
            }
            .btn-borrar {
                margin-top: 0;
            }
            .producto-imagen {
                text-align: center;
                margin-top: 1rem;
            }
            .producto-imagen img {
                width: 100%;
                height: 150px; /* Más grande en móvil */
            }
            .conte-titulo-form-carga {
                flex-direction: column;
                align-items: flex-start;
                gap: 1rem;
            }
        }
    </style>
</head>

<body>
    
    <header>
        <!-- Puedes poner un partial de tu header aquí si lo tienes -->
    </header>
    
    <main>
        <!-- 3. Mantuve tu estructura de cabecera HTML, pero el CSS de arriba le da el nuevo estilo -->
        <div class="FormularioDeCarga"> <!-- Este es un contenedor general, no solo el formulario -->
            <div class="Center">
                
                <div class="SearchBox">
                    <div class="conte-titulo-form-carga">
                        <div class="titulo-icon-form-carga">
                            <div class="icon-form-carga"><i class="fa-solid fa-rectangle-list"></i></div>
                            <!-- El título ahora es 'Lista de Motos' -->
                            <div class="titulo-form-carga">Lista de Motos</div>
                        </div>
                        
                        <div>
                            <!-- Botón para ir al formulario de carga -->
                            <form class="SearchBox-form" action="/admin/formCargaLibro" method="GET">
                                <button class="icon-carga-producto" type="submit">
                                    <i class="fa-solid fa-folder-plus"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    
                    <!-- Formulario de Búsqueda -->
                    <form class="lista-libros-busq" action="/admin/search" method="GET">
                        <input class="input-text-busq" type="text" placeholder="Buscar por nombre..." name="search">
                        <button type="submit" class="button-busq">
                            <i class="fa-solid fa-magnifying-glass"></i>
                        </button>
                    </form>
                </div>

                <!-- 4. Aquí empieza la lista de productos (motos) -->
                <div class="IndexList">
                    <div class="Productos">
                        
                        <!-- 5. Este es el BUCLE EJS modificado para usar la nueva estructura de tarjeta -->
                        <% if (moto && moto.length > 0) { %>
                            <% moto.forEach(moto => { %>
                                
                                <div class="Producto">
                                    
                                    <!-- Columna Izquierda: Acciones -->
                                    <div class="producto-acciones">
                                        <!-- Asumo que usas 'idUnico' para editar -->
                                        <a href="/formularioParaEditar-moto/<%= moto.idUnico %>" class="accion-link">Editar</a>
                                        
                                        <!-- Asumo que la ruta de detalle es así -->
                                        <a href="/modelo/<%= moto.idUnico %>" class="accion-link">Detalles</a>
                                        
                                        <!-- Formulario para BORRAR (DELETE) -->
                                        <!-- <form action="/admin/borrar/<%= moto.idUnico %>?_method=DELETE" method="POST" style="margin: 0;">
                                            <button type="submit" class="btn-borrar">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form> -->
                                        <a href="/borrar-moto/<%= moto.idUnico %>" class="accion-link">Borrar<i class="fa-solid fa-trash-can"></i></a>

                                    </div>
                                    
                                    <!-- Columna Central: Información -->
                                    <div class="producto-info">
                                        <a href="/producto/<%= moto.idUnico %>" class="info-titulo">
                                            <%= moto.nombre %>
                                        </a>
                                        <!-- Reemplacé "autor" y "stock" por campos de tus motos -->
                                        
                                        <span class="info-subtitulo">
                                            Codigo: <%= moto.codigo || 'N/A' %>
                                        </span><span class="info-subtitulo">
                                            Año: <%= moto.año || 'N/A' %>
                                        </span>
                                        <span class="info-subtitulo">
                                            Estado: <%= moto.activo || 'N/A' %>
                                        </span>
                                        <span class="info-stock">
                                            Color: <%= moto.color || 'N/A' %>
                                        </span>
                                    </div>
                                    
                                    <!-- Columna Derecha: Imagen -->
                                    <div class="producto-imagen">
                                        <img 
                                            src="/img/motos/<%= moto.img %>" 
                                            alt="Imagen de <%= moto.nombre %>"
                                            onerror="this.src='https://placehold.co/100x100/EBF4F5/333?text=Sin+Imagen'; this.style.objectFit='contain';"
                                        >
                                    </div>
                                </div>
                                
                            <% }); %>
                        <% } else { %>
                            <p>No se encontraron motos para mostrar.</p>
                        <% } %>
                        
                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer>
        <!-- Puedes poner un partial de tu footer aquí -->
    </footer>
</body>
</html>